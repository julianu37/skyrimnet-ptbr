{# Use events context variable if set by C++, otherwise fetch via decorator #}
{% if not exists("events") or length(events) == 0 %}{% set _event_filter = [] %}
{% if exists("npc") and existsIn(npc, "UUID") %}{% set _event_filter = append(_event_filter, npc.UUID) %}{% endif %}
{% if exists("responseTarget") and existsIn(responseTarget,"UUID") %}{% set _event_filter = append(_event_filter, responseTarget.UUID) %}{% endif %}
{% if exists("maxRecentEvents") %}{% set _event_count = maxRecentEvents %}{% else if exists("npc") and existsIn(npc, "UUID") %}{% set _event_count = get_event_history_count(npc.UUID) %}{% else %}{% set _event_count = get_event_history_count(0) %}{% endif %}
{% set events = get_recent_events(_event_count, _event_filter) %}{% endif %}
{% set _npc_is_private_virtual = false %}
{% if exists("npc") and existsIn(npc, "UUID") %}{% set _npc_is_private_virtual = decnpc(npc.UUID).isVirtualPrivate %}{% endif %}
{% set lastLocation = "" %}
{% set lastSignificantTime = 0 %}
{% set latestGMDialogueTime = 0 %}
{% for event in events %}{% if event.type == "gamemaster_dialogue" %}{% set latestGMDialogueTime = event.gameTime %}{% endif %}{% endfor %}
{% set hasShownGMDialogue = false %}
{% for event in events %}
    {% if event.type != "spell" and event.type != "hit" and event.type != "combat" %}
        {% set locationChanged = (lastLocation != "" and event.location != lastLocation) %}
        {% set timeDiff = gameTimeNumeric - event.gameTime %}
        {% if lastSignificantTime > 0 %}
            {% set timeSinceLastSignificant = event.gameTime - lastSignificantTime %}
        {% else %}
            {% set timeSinceLastSignificant = 0 %}
        {% endif %}
        {% set timeIndicator = "" %}
        {% set showTimeGap = false %}

        {% if timeDiff > 604800 %}{% set timeIndicator = "[Há mais de uma semana] " %}
        {% else if timeDiff > 172800 %}{% set timeIndicator = "[Há vários dias] " %}
        {% else if timeDiff > 86400 %}{% set timeIndicator = "[Ontem] " %}
        {% else if timeDiff > 28800 %}{% set timeIndicator = "[Há muitas horas] " %}
        {% else if timeDiff > 14400 %}{% set timeIndicator = "[Mais cedo hoje] " %}
        {% else if timeDiff > 7200 %}{% set timeIndicator = "[Há algumas horas] " %}
        {% else if timeDiff > 3600 %}{% set timeIndicator = "[Há cerca de uma hora] " %}
        {% else if timeDiff > 1800 %}{% set timeIndicator = "[Há um tempo] " %}
        {% endif %}

        {% if timeSinceLastSignificant > 1800 %}{% set showTimeGap = true %}{% endif %}

        {% if showTimeGap and lastSignificantTime > 0 %}
            {% set gapDescription = "" %}
            {% if timeSinceLastSignificant > 31536000 %}{% set gapDescription = "Mais de um ano depois..." %}
            {% else if timeSinceLastSignificant > 15552000 %}{% set gapDescription = "Muitos meses depois..." %}
            {% else if timeSinceLastSignificant > 7776000 %}{% set gapDescription = "Vários meses depois..." %}
            {% else if timeSinceLastSignificant > 5184000 %}{% set gapDescription = "Alguns meses depois..." %}
            {% else if timeSinceLastSignificant > 2592000 %}{% set gapDescription = "Um mês depois..." %}
            {% else if timeSinceLastSignificant > 1209600 %}{% set gapDescription = "Algumas semanas depois..." %}
            {% else if timeSinceLastSignificant > 604800 %}{% set gapDescription = "Uma semana depois..." %}
            {% else if timeSinceLastSignificant > 86400 %}{% set gapDescription = "No dia seguinte..." %}
            {% else if timeSinceLastSignificant > 28800 %}{% set gapDescription = "Muitas horas depois..." %}
            {% else if timeSinceLastSignificant > 14400 %}{% set gapDescription = "Várias horas se passam..." %}
            {% else if timeSinceLastSignificant > 7200 %}{% set gapDescription = "Algumas horas depois..." %}
            {% else if timeSinceLastSignificant > 3600 %}{% set gapDescription = "Cerca de uma hora se passa..." %}
            {% else if timeSinceLastSignificant > 1800 %}{% set gapDescription = "Algum tempo se passa..." %}
            {% endif %}
- *{{ gapDescription }}* ({{ event.gameTimeStr }})
        {% endif %}

        {% if event.type == "gamemaster_dialogue" %}
            {% if event.gameTime == latestGMDialogueTime and not hasShownGMDialogue %}
- [{{ short_time(event.gameTimeStr) }}] {{ format_event(event, "compact") }}
                {% set hasShownGMDialogue = true %}
            {% endif %}
        {% else if event.type == "direct_narration" %}
- {{ timeIndicator }}*{{ format_event(event, "compact") }}*
        {% else %}
{# Telepathy: an NPC thought rendered into a different actor's prompt context (canonical-telepath audience expansion). Mark so the LLM doesn't read it as spoken dialogue. #}
{% set _isTelepathyObserved = event.type == "npc_thoughts" and exists("npc") and existsIn(npc, "UUID") and event.originatingActor != npc.UUID %}
- [{{ short_time(event.gameTimeStr) }}] {% if locationChanged %}[Agora em {{ event.location }}] {% endif %}({{ event.type }}) {% if event.type == "dialogue" or event.type == "dialogue_npc" or event.type == "dialogue_player" or event.type == "dialogue_player_stt" or event.type == "dialogue_player_text" or event.type == "dialogue_background"%}{% if isValidActor(event.originatingActor) %}{{ get_name(event.originatingActor) }}{% if isValidActor(event.targetActor) %}{% if decnpc(event.targetActor).isVirtualPrivate and not _npc_is_private_virtual %}{% if decnpc(event.originatingActor).isFemale %} (falando consigo mesma){% else %} (falando consigo mesmo){% endif %}{% else %} para {{ get_name(event.targetActor) }}{% endif %}{% endif %}: {% else if event.type == "dialogue_background" and event.data and event.data.speaker != "" %}{{ event.data.speaker }}: {% endif %}{% else %}{% if isValidActor(event.originatingActor) %}{{ get_name(event.originatingActor) }}{% if _isTelepathyObserved %} (pensamento, observado telepaticamente){% endif %}: {% endif %}{% endif %}{{ format_event(event, "compact") }}
        {% endif %}

        {% set lastLocation = event.location %}
        {% if showTimeGap or lastSignificantTime == 0 %}{% if existsIn(event, "gameTimeEnd") and event.gameTimeEnd %}{% set lastSignificantTime = event.gameTimeEnd %}{% else %}{% set lastSignificantTime = event.gameTime %}{% endif %}{% endif %}
    {% endif %}
{% endfor %}
{% if lastSignificantTime > 0 %}
    {% if exists("npc") and existsIn(npc, "UUID") %}{% set currentActorLocation = get_location(npc.UUID) %}{% else %}{% set currentActorLocation = location %}{% endif %}
    {% set timeSinceLastEvent = gameTimeNumeric - lastSignificantTime %}
    {% set locationChangedSinceLastEvent = (lastLocation != "" and lastLocation != currentActorLocation) %}
    {% set timePassedDescription = "" %}
    {% if timeSinceLastEvent > 31536000 %}{% set timePassedDescription = "Mais de um ano se passou" %}
    {% else if timeSinceLastEvent > 15552000 %}{% set timePassedDescription = "Muitos meses se passaram" %}
    {% else if timeSinceLastEvent > 7776000 %}{% set timePassedDescription = "Vários meses se passaram" %}
    {% else if timeSinceLastEvent > 5184000 %}{% set timePassedDescription = "Alguns meses se passaram" %}
    {% else if timeSinceLastEvent > 2592000 %}{% set timePassedDescription = "Um mês se passou" %}
    {% else if timeSinceLastEvent > 1209600 %}{% set timePassedDescription = "Algumas semanas se passaram" %}
    {% else if timeSinceLastEvent > 604800 %}{% set timePassedDescription = "Mais de uma semana se passou" %}
    {% else if timeSinceLastEvent > 172800 %}{% set timePassedDescription = "Vários dias se passaram" %}
    {% else if timeSinceLastEvent > 86400 %}{% set timePassedDescription = "Um dia se passou" %}
    {% else if timeSinceLastEvent > 28800 %}{% set timePassedDescription = "Muitas horas se passaram" %}
    {% else if timeSinceLastEvent > 14400 %}{% set timePassedDescription = "Várias horas se passaram" %}
    {% else if timeSinceLastEvent > 7200 %}{% set timePassedDescription = "Algumas horas se passaram" %}
    {% else if timeSinceLastEvent > 3600 %}{% set timePassedDescription = "Cerca de uma hora se passou" %}
    {% else if timeSinceLastEvent > 1800 %}{% set timePassedDescription = "Algum tempo se passou" %}
    {% else if timeSinceLastEvent > 600 %}{% set timePassedDescription = "Um pouco de tempo se passou" %}
    {% endif %}
    {% if timePassedDescription != "" or locationChangedSinceLastEvent %}
- *{{ timePassedDescription }}{% if locationChangedSinceLastEvent %}{% if timePassedDescription != "" %}, agora{% else %}Agora{% endif %} em {{ currentActorLocation }}{% endif %}.*
    {% endif %}
{% endif %}
