{% for t in tag_list %}
- {{ t }}: {% if t == "flat" %}sem graça ou genérica{% else if t == "unnatural" %}antinatural ou rígida{% else if t == "out_of_character" %}fora do personagem{% else if t == "wrong_tone" %}tom errado para o momento{% else if t == "ignored_input" %}ignorou o que foi dito a ela{% else if t == "wrong_facts" %}fatos errados{% else if t == "too_long" %}longa demais{% else if t == "repeated" %}repetiu a si mesma{% else if t == "broke_format" %}quebrou o formato da resposta{% else if t == "spoke_for_player" %}falou ou agiu pelo jogador{% else if t == "changed_meaning" %}mudou o que era pretendido{% else if t == "not_translated" %}deixou sem tradução{% else if t == "invented" %}inventou coisas{% else if t == "missed_important" %}perdeu algo importante{% else if t == "trivial" %}não vale a pena lembrar{% else if t == "wrong_perspective" %}escrita do ponto de vista errado{% else if t == "irrelevant" %}irrelevante para o momento{% else if t == "too_vague" %}vaga demais para encontrar algo{% else if t == "dropped_info" %}descartou o que já era sabido{% else if t == "hallucinated" %}descreve coisas que não estão lá{% else if t == "wrong_tool" %}usou a ferramenta errada{% else if t == "wrong_arguments" %}passou os argumentos errados para a ferramenta{% else %}{{ t }}{% endif %}
{% endfor %}
