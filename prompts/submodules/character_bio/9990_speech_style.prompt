{# Suprimido quando uma entidade vinculada veste plenamente este corpo (entity_led): o modo de
   falar do hospedeiro é descartado para que a própria voz da entidade (emprestada via 7050) conduza a fala.
   A coleta speech_style da entidade recalcula a flag para false, então ela sempre renderiza. #}
{% if render_mode == "speech_style" and not suppress_host_persona %}
    ## Perfil de Fala de {{ decnpc(actorUUID).name }}
    {% block speech_style %}{% endblock %}
    {% if decnpc(actorUUID).universalTranslatorSpeechPattern %}
    ### Padrão de Fala
    {{ decnpc(actorUUID).universalTranslatorSpeechPattern }}
    {% endif %}
    {% block speech_style_creature %}
        {% set race =  decnpc(actorUUID).race %}
        {% set speech = "" %}
        {% if race == "Bear" %}
            {% set speech = "não consegue usar palavras humanas, apenas sons animais como rosnados e rugidos." %}
        {% else if race == "Cave Bear" %}
            {% set speech = "não consegue usar palavras humanas, apenas sons animais como rosnados e rugidos." %}
        {% else if race == "Chaurus" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite estalidos e cliques de inseto." %}
        {% else if race == "ChaurusFlyer" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite estalidos e cliques de inseto." %}
        {% else if race == "Chicken" %}
            {% set speech = "não consegue usar palavras humanas, apenas cacareja e canta." %}
        {% else if race == "Deathhound" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite rosnados graves e guturais e uivos sobrenaturais." %}
        {% else if race == "Deer" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons animais como balidos." %}
        {% else if race == "Dog" %}
            {% set speech = "não consegue usar palavras humanas, apenas sons animais e linguagem corporal." %}
        {% else if race == "Dragon Priest" %}
            {% set speech = "consegue usar palavras humanas e gritos na Dragon Tongue, falando com uma voz antiga e rouca." %}
        {% else if race == "Dragon Race" %}
            {% set speech = "consegue usar palavras humanas e sua própria língua poderosa, conhecida como Dragon Tongue." %}
        {% else if race == "Draugr" %}
            {% set speech = "consegue usar palavras isoladas da Dragon Tongue como gritos, mas fora isso apenas grunhidos e gemidos." %}
        {% else if race == "Dwarven Centurion" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por zumbidos mecânicos, chiados e estalos metálicos." %}
        {% else if race == "Dwarven Sphere" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por zumbidos mecânicos, chiados e estalos metálicos." %}
        {% else if race == "Dwarven Spider" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por zumbidos mecânicos, chiados e estalos metálicos." %}
        {% else if race == "Falmer" %}
            {% set speech = "não usa línguas humanas, mas fala a língua dos Falmer, que soa áspera, gutural e estridente, com cliques de morcego." %}
        {% else if race == "Flame Atronach" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons elementais correspondentes ao seu tipo." %}
        {% else if race == "Fox" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons animais como ganidos e latidos." %}
        {% else if race == "Frost Atronach" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons elementais correspondentes ao seu tipo." %}
        {% else if race == "Frostbite Spider" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sibilos e ruídos de patas." %}
        {% else if race == "Gargoyle" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por gemidos pétreos e o ranger da pedra." %}
        {% else if race == "Giant" %}
            {% set speech = "consegue usar apenas palavras e frases humanas simples." %}
        {% else if race == "Goat" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite balidos." %}
        {% else if race == "HMDaedra" %}
            {% if contains(decnpc(actorUUID).name,"seeker") %}
                {% set speech = "não consegue usar palavras humanas, apenas se comunica por um zumbido profundo e sobrenatural." %}
            {% else %}
                {% set speech = "não consegue usar palavras humanas, apenas se comunica por sussurros baixos e sobrenaturais." %}
            {% endif %}
        {% else if race == "Hagraven" %}
            {% set speech = "consegue usar palavras humanas, falando com uma voz áspera, gargalhante e cruel." %}
        {% else if race == "Highlandcow" %}
            {% set speech = "não consegue usar palavras humanas, apenas muge." %}
        {% else if race == "Horker" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite grunhidos altos e roucos." %}
        {% else if race == "Horse" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons animais como relinchos e bufos." %}
        {% else if race == "Ice Wraith" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite um sibilo gélido e etéreo." %}
