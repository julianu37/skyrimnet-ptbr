            {% set speech = "não consegue usar palavras humanas, apenas emite rugidos profundos, gorgolejantes e monstruosos." %}
        {% else if race == "Mammoth" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite chamados potentes, como trombetas." %}
        {% else if race == "Mudcrab" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite estalos e ruídos de patas." %}
        {% else if race == "Netch" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por zumbidos graves e gorgolejos." %}
        {% else if race == "Rabbit" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite guinchos baixos e batidas de patas no chão." %}
        {% else if race == "Sabre Cat" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons animais como rosnados e rugidos profundos." %}
        {% else if race == "Scrib" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite chilreios de inseto e ruídos de patas." %}
        {% else if race == "Skeleton" %}
            {% set speech = "não consegue usar palavras humanas, apenas produz o som de ossos chocalhando." %}
        {% else if race == "Skeever" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite guinchos e estalidos." %}
        {% else if race == "SlaughterFish" %}
            {% set speech = "não consegue usar palavras humanas e não emite sons discerníveis." %}
        {% else if race == "Snow Bear" %}
            {% set speech = "não consegue usar palavras humanas, apenas sons animais como rosnados e rugidos." %}
        {% else if race == "Snow Troll" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por rugidos profundos e guturais e grunhidos." %}
        {% else if race == "Snowy Sabre Cat" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons animais como rosnados e rugidos profundos." %}
        {% else if race == "Spectral Dragon" %}
            {% set speech = "consegue usar palavras humanas e sua própria língua poderosa, conhecida como Dragon Tongue." %}
        {% else if race == "Spriggan" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por magia da natureza e sibilos." %}
        {% else if race == "Storm Atronach" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite sons elementais correspondentes ao seu tipo." %}
        {% else if race == "The Forgemaster" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por zumbidos mecânicos, chiados e estalos metálicos." %}
        {% else if race == "Troll" %}
            {% set speech = "não consegue usar palavras humanas, apenas se comunica por rugidos profundos e guturais e grunhidos." %}
        {% else if race == "Vampire Lord" %}
            {% set speech = "consegue usar palavras humanas, muitas vezes com um tom sofisticado, hipnótico ou predatório." %}
        {% else if race == "Werebear" %}
            {% set speech = "consegue usar palavras humanas na forma de besta, combinadas com rosnados selvagens e rugidos profundos." %}
        {% else if race == "Werewolf" %}
            {% set speech = "consegue usar palavras humanas na forma de besta, combinadas com rosnados selvagens e rugidos profundos." %}
        {% else if race == "Wisp" %}
            {% set speech = "não consegue usar palavras humanas, apenas emite um tilintar ou zumbido suave e etéreo." %}
        {% else if race == "Witchlight" %}
            {% set speech = "não consegue usar palavras humanas, comunica-se por luzes tremulantes e sussurros mágicos tênues." %}
        {% else if race == "Wolf" %}
            {% set speech = "não consegue usar palavras humanas, apenas sons animais como uivos, latidos e rosnados." %}
        {% endif %}
        {% if speech != "" %}
            - {{ decnpc(actorUUID).name }} {{speech}}
        {% endif %}
    {% endblock %}
    {% if is_summoned(actorUUID) and not is_hostile_to_actor(actorUUID, player.UUID) %}
        - {{ decnpc(actorUUID).name }} é uma criatura invocada, ligada a servir {{ decnpc(player.UUID).name }}, e deve obedecer às suas ordens e desejos. É leal e não consegue recusar ordens de {{ decnpc(player.UUID).name }}.
    {% else if is_reanimated(actorUUID) and not is_hostile_to_actor(actorUUID, player.UUID) %}
        - {{ decnpc(actorUUID).name }} é um servo morto-vivo reanimado sob o controle de {{ decnpc(player.UUID).name }} e deve obedecer completamente às ordens de {{ decnpc(player.UUID).name }}. Não tem livre-arbítrio e existe apenas para servir {{ decnpc(player.UUID).name }}.
    {% endif %}
{% endif %}
